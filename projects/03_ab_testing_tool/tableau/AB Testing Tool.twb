              <zone forceUpdate='true' h='16372' id='12' type-v2='text' w='82335' x='16865' y='82561'>
                <formatted-text>
                  <run bold='true' fontcolor='#555555' fontname='monospace' fontsize='10'>Method: </run>
                  <run fontcolor='#555555' fontname='monospace' fontsize='10'>Two-Proportion Z-Test (two-tailed, α = 0.05)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontname='monospace' fontsize='10'>1. Calculate conversion rates for Control (group 1) and Test (group 2)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontname='monospace' fontsize='10'>2. Compute pooled proportion and standard error</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#555555' fontname='monospace' fontsize='10'>3. Calculate Z-statistic and two-tailed P-value</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#555555' fontname='monospace' fontsize='10'>Decision:</run>
                  <run fontcolor='#555555' fontname='monospace' fontsize='10'><![CDATA[ P-value < 0.05 → Significant (red) | P-value ≥ 0.05 → Not Significant (black)]]></run>
                </formatted-text>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
          </zone>
