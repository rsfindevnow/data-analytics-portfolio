      <column caption='AOV - Delta Icon' datatype='string' name='[CR - Delta Icon (copy)_1105045862477871]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1105045861421100] &gt; [Calculation_1105045861490733] THEN &quot;▲&quot;&#13;&#10;ELSEIF [Calculation_1105045861421100] &lt; [Calculation_1105045861490733] THEN &quot;▼&quot;&#13;&#10;ELSE &quot;=&quot;&#13;&#10;END' />
      </column>
      <column datatype='real' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_SUM([Calculation_1105045548986369], -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_1105045548986369]) - LOOKUP(ZN([Calculation_1105045548986369]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_1105045548986369], -6, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_1105045548986369]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue])' />
      </column>
      <column caption='Orders' datatype='integer' name='[Calculation_1105045549805570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [has_purchase] = True THEN [ga_session_id] END)' />
      </column>
      <column caption='Sessions' datatype='integer' name='[Calculation_1105045550108675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([ga_session_id])' />
      </column>
      <column caption='AOV Proxy' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_1105045550231556]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Calculation_1105045549805570] &gt; 0, [Calculation_1105045548986369] / [Calculation_1105045549805570], NULL)' />
      </column>
      <column caption='Revenue Share' datatype='real' default-format='p0.00%' name='[Calculation_1105045551927303]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue]) / TOTAL(SUM([revenue]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='User Type' datatype='string' name='[Calculation_1105045554208776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [user_id] &gt; 0 THEN &quot;Registered&quot; ELSE &quot;Unregistered&quot; END' />
      </column>
      <column caption='Email Status' datatype='string' name='[Calculation_1105045555126281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [user_id] &gt; 0 THEN&#13;&#10;    IIF([email_verified] = 1, &quot;Verified&quot;, &quot;Not Verified&quot;)&#13;&#10;ELSE &quot;N/A (Unregistered)&quot;&#13;&#10;END' />
      </column>
      <column caption='Subscription Status' datatype='string' name='[Calculation_1105045555490826]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [user_id] &gt; 0 THEN&#13;&#10;    IIF([is_subscribed] = 1, &quot;Subscribed&quot;, &quot;Not Subscribed&quot;)&#13;&#10;ELSE &quot;N/A (Unregistered)&quot;&#13;&#10;END' />
      </column>
      <column caption='Continent Rank' datatype='integer' name='[Calculation_1105045555720203]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1105045548986369], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country Rank' datatype='integer' name='[Calculation_1105045556109324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1105045548986369], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Continent Group' datatype='string' name='[Calculation_1105045556690958]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1105045555720203] &lt;= 5 THEN ATTR([continent]) ELSE &quot;Others&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Country Group' datatype='string' name='[Calculation_1105045557563407]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1105045556109324] &lt;= 10 THEN ATTR([country]) ELSE &quot;Others&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Rank' datatype='integer' name='[Calculation_1105045557661712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE([Calculation_1105045548986369], &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Category Group' datatype='string' name='[Calculation_1105045557821457]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1105045557661712] &lt;= 10 THEN ATTR([product_category]) ELSE &quot;Others&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected Dimension' datatype='string' name='[Calculation_1105045561561107]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Country&quot; THEN [country]&#13;&#10;    WHEN &quot;Category&quot; THEN [product_category]&#13;&#10;    WHEN &quot;Channel&quot; THEN [traffic_channel]&#13;&#10;    WHEN &quot;Device&quot; THEN [device]&#13;&#10;END' />
      </column>
      <column caption='Date Filter - Dynamic' datatype='boolean' name='[Calculation_1105045815132184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Last 1 Day&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 1&#13;&#10;    WHEN &quot;Last 7 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 7&#13;&#10;    WHEN &quot;Last 30 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 30&#13;&#10;    ELSE&#13;&#10;        TRUE&#13;&#10;END' />
      </column>
      <column caption='Period Length' datatype='integer' name='[Calculation_1105045818466329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Last 1 Day&quot; THEN 1&#13;&#10;    WHEN &quot;Last 7 Days&quot; THEN 7&#13;&#10;    WHEN &quot;Last 30 Days&quot; THEN 30&#13;&#10;    WHEN &quot;Last 90 Days&quot; THEN 90&#13;&#10;    ELSE 90&#13;&#10;END' />
      </column>
      <column caption='Date Filter - Previous Period' datatype='boolean' name='[Calculation_1105045818650650]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Last 1 Day&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &gt; 1&#13;&#10;        AND DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 2&#13;&#10;    WHEN &quot;Last 7 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &gt; 7&#13;&#10;        AND DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 14&#13;&#10;    WHEN &quot;Last 30 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &gt; 30&#13;&#10;        AND DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 60&#13;&#10;    WHEN &quot;Last 90 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &gt; 90&#13;&#10;        AND DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 180&#13;&#10;    ELSE&#13;&#10;        FALSE&#13;&#10;END' />
      </column>
      <column caption='Revenue - Current' datatype='real' name='[Calculation_1105045819719708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1105045815132184] THEN [revenue] ELSE 0 END' />
      </column>
      <column caption='Revenue - Previous' datatype='real' default-format='c&quot;$&quot;#,##0,.0K;(&quot;$&quot;#,##0,.0K)' name='[Calculation_1105045820313629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1105045818650650] THEN [revenue] ELSE 0 END' />
