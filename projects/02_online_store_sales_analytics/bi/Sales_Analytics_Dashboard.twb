      <column caption='Revenue Delta %' datatype='real' default-format='p0.0%' name='[Calculation_1105045820653598]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_1105045820313629]) = 0 THEN NULL&#13;&#10;ELSE (SUM([Calculation_1105045819719708]) - SUM([Calculation_1105045820313629])) / SUM([Calculation_1105045820313629])&#13;&#10;END' />
      </column>
      <column caption='Revenue - Delta Icon' datatype='string' name='[Calculation_1105045821870111]' role='measure' type='nominal'>
