    <worksheet name='D1 Revenue by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#aa0000' fontsize='18'>Revenue by Product Category (TOP-10)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales Analytics Data' name='federated.1h696dj1n3anz914h8cjw05kczjn' />
          </datasources>
          <datasource-dependencies datasource='federated.1h696dj1n3anz914h8cjw05kczjn'>
            <column caption='Total Revenue' datatype='real' name='[Calculation_1105045548986369]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue])' />
            </column>
            <column caption='Revenue Share' datatype='real' default-format='p0.00%' name='[Calculation_1105045551927303]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue]) / TOTAL(SUM([revenue]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[product_category]' derivation='None' name='[none:product_category:nk]' pivot='key' type='nominal' />
            <column caption='Product Category' datatype='string' name='[product_category]' role='dimension' type='nominal' />
            <column caption='Revenue' datatype='real' name='[revenue]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1105045548986369]' derivation='User' name='[usr:Calculation_1105045548986369:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1105045551927303]' derivation='User' name='[usr:Calculation_1105045551927303:qk:4]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
