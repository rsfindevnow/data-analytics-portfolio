              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#13;&#10;    WHEN &quot;Last 1 Day&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 1&#13;&#10;    WHEN &quot;Last 7 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 7&#13;&#10;    WHEN &quot;Last 30 Days&quot; THEN&#13;&#10;        DATEDIFF(&apos;day&apos;, [order_date], {MAX([order_date])}) &lt;= 30&#13;&#10;    ELSE&#13;&#10;        TRUE&#13;&#10;END' />
