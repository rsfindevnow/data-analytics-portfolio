              <calculation class='tableau' formula='IF COUNTD([Calculation_1105045848674338]) &gt; 0 THEN&#13;&#10;    COUNTD([Calculation_1105045847117856]) / COUNTD([Calculation_1105045848674338])&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
